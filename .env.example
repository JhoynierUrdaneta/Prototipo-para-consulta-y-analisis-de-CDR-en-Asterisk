# ============================================================
#  Plantilla de configuración. Copiar a .env y rellenar.
#  El archivo .env real NUNCA se sube al repositorio.
#
#  Para desarrollo local puedes dejarlo todo vacío: docker-compose
#  usa valores por defecto suficientes para levantar el proyecto.
# ============================================================

# --- Base de datos del aplicativo (usuarios, chats, tableros) ---
# Solo alfanumérica: va dentro de la URL de conexión.
DB_PASSWORD=

# --- Secretos de la aplicación ---
# APP_SECRET_KEY cifra las credenciales de las integraciones guardadas en la BD.
# Si la cambias, hay que volver a configurar OpenAI/Supabase/SMTP desde la web.
APP_SECRET_KEY=
JWT_SECRET=
INTERNAL_KEY=

# --- Entorno ---
# CORS_ORIGINS: en producción, la URL pública exacta (no "*").
CORS_ORIGINS=*
ENV=dev

# --- Publicación del frontend ---
# FRONTEND_PORT: 8095 por defecto (8090 suele estar ocupado por otros programas).
# FRONTEND_HOST: en producción 127.0.0.1 si va detrás de un proxy.
FRONTEND_PORT=8095
FRONTEND_HOST=0.0.0.0

# --- Usuarios iniciales (opcional) ---
# Solo se crean la primera vez, con la base vacía.
# Si se omiten, se usan los valores por defecto de backend/app/config.py.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SUPERVISOR_PASSWORD=
# COORDINADOR_PASSWORD=
# FINANCIERO_PASSWORD=

# ============================================================
#  NO van aquí: la contraseña de Supabase, la API key de OpenAI
#  ni la del SMTP. Esas se cargan desde la propia aplicación
#  (Configuración) y se guardan cifradas en la base de datos.
# ============================================================
